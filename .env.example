# Copy to .env and fill in. Never commit .env.
GMI_API_KEY=your-gmi-api-key
GMI_MODEL=copy-exact-model-id-from-your-gmi-catalog
GMI_BASE_URL=https://api.gmi-serving.com/v1
GITHUB_TOKEN=your-fine-grained-read-only-token
# Only for `repopilot approve`: fine-grained, one repo, Contents + Pull requests read/write.
# GITHUB_WRITE_TOKEN=your-fine-grained-write-token
# PRICE_IN_PER_M=0.14
# PRICE_OUT_PER_M=0.28
# Only for `repopilot serve`: at least 16 characters.
# REPOPILOT_API_KEY=generate-a-long-random-key
