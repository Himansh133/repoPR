 """URL slugs."""
 
+import re
+
 
 def slugify(title):
-    """Turn a title into a URL slug: lowercase words joined by single hyphens."""
-    return title.lower().replace(" ", "-")
+    """Turn a title into a URL slug: lowercase letters, digits and single hyphens."""
+    words = []
+    for word in title.lower().split():
+        word = re.sub(r"[^a-z0-9]+", "", word)
+        if word:
+            words.append(word)
+    return "-".join(words)
